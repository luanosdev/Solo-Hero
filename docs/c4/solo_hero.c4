// docs/c4/solo_hero.c4

// 1. Especificação dos tipos de elementos que usaremos na arquitetura.
// Conforme a documentação do likec4.
specification {
    element actor
    element system
    element container
    element component
}

// 2. Modelo da nossa arquitetura, definindo os elementos e suas relações.
model {
    // Atores (Pessoas)
    player = actor "Jogador" {
        description "O usuário final que joga o Solo Hero."
        style {
            shape person
        }
    }

    // Sistemas Externos
    love2d = system "LÖVE 2D Engine" {
        description "A engine gráfica e de jogo na qual o Solo Hero é construído."
    }

    // Nosso Sistema Principal
    soloHero = system "Solo Hero" {
        description "A aplicação principal do jogo, responsável por toda a experiência."

        // Contêineres dentro do nosso sistema (Nível C2)
        gameClient = container "Game Client" {
            description "Executa toda a lógica de jogo, renderização, gerenciamento de estado e interface do usuário."
            technology "LÖVE 2D (Lua)"

            // --- Camada de Serviços Globais ---
            services = component "Global Services" {
                description "Conjunto de serviços singleton disponíveis em todo o jogo."
                technology "Lua Modules"

                inputService = component "Input Service" {
                    description "Mapeia inputs físicos para ações abstratas de jogo."
                    technology "Lua Class"
                }

                eventService = component "Event Service" {
                    description "Sistema de eventos desacoplado para comunicação entre componentes."
                    technology "Lua Class"
                }

                serviceLocator = component "Service Locator" {
                    description "Registry central para localizar serviços globais."
                    technology "Lua Class"
                }

                localizationService = component "Localization Service" {
                    description "Sistema de tradução e localização global."
                    technology "Lua Class"
                }
            }

            // --- Gerenciador de Cenas ---
            sceneManager = component "Scene Manager" {
                description "Gerencia o ciclo de vida e as transições entre as diferentes cenas do jogo."
                technology "Lua Class"
            }

            // --- Cenas do Jogo ---
            mainMenu = component "Main Menu Scene" {
                description "Cena inicial que permite ao jogador começar a jornada."
                technology "Lua Class"
            }

            lobby = component "Lobby Scene" {
                description "Hub central onde o jogador se prepara para as missões."
                technology "Lua Class"

                hunterManager = component "Hunter Manager" {
                    description "Gerencia hunters, arquétipos e progressão."
                    technology "Lua Class"
                }

                agencyManager = component "Agency Manager" {
                    description "Gerencia a agência do jogador e suas funcionalidades."
                    technology "Lua Class"
                }

                inventoryManager = component "Inventory Manager" {
                    description "Gerencia o inventário do jogador."
                    technology "Lua Class"
                }
            }

            gameplay = component "Gameplay Scene" {
                description "A cena principal onde ocorre a jogabilidade core (combate, exploração)."
                technology "Lua Class"
                // Detalhamento será adicionado em uma versão futura
            }

            summary = component "Extraction Summary Scene" {
                description "Mostra o resumo e as recompensas da partida após a extração."
                technology "Lua Class"
            }

            // --- Camada de Dados ---
            dataLayer = component "Data Layer" {
                description "Gerencia todos os dados do jogo, desde configurações até itens."
                technology "Lua Modules"

                itemDataManager = component "Item Data Manager" {
                    description "Carrega e gerencia dados base de todos os itens do jogo."
                    technology "Lua Class"
                }

                persistenceManager = component "Persistence Manager" {
                    description "Salva e carrega dados do jogador em arquivos .dat."
                    technology "Lua Class"
                }

                configData = component "Configuration Data" {
                    description "Dados de configuração e constantes do jogo."
                    technology "Lua Modules"
                }

                gameData = component "Game Data" {
                    description "Dados balanceáveis como arquétipos, inimigos, mapas."
                    technology "Lua Modules"
                }
            }

            // --- Relações Principais ---
            sceneManager -> mainMenu "Inicia com"
            mainMenu -> sceneManager "Solicita transição"
            lobby -> sceneManager "Solicita transição"
            gameplay -> sceneManager "Solicita transição"
            summary -> sceneManager "Solicita transição"

            sceneManager -> lobby "Transiciona para"
            sceneManager -> gameplay "Transiciona para"
            sceneManager -> summary "Transiciona para"

            // Todas as cenas utilizam services
            mainMenu -> services "Utiliza"
            lobby -> services "Utiliza"
            gameplay -> services "Utiliza"
            summary -> services "Utiliza"

            // Managers da lobby utilizam data layer
            lobby.hunterManager -> dataLayer.persistenceManager "Carrega/salva dados"
            lobby.inventoryManager -> dataLayer.itemDataManager "Obtém dados de itens"
            lobby.agencyManager -> dataLayer.persistenceManager "Carrega/salva dados"

            // Data layer utiliza persistence
            dataLayer.itemDataManager -> dataLayer.configData "Carrega configurações"
            dataLayer.gameData -> dataLayer.configData "Utiliza constantes"
        }

        persistence = container "Sistema de Persistência" {
            description "Armazena o progresso do jogador, como hunters, itens e conquistas."
            technology "Sistema de Arquivos (.dat)"
            style {
                shape storage
            }
        }

        // Relações internas ao sistema
        gameClient -> persistence "Lê e escreve dados do progresso"
        gameClient.dataLayer.persistenceManager -> persistence "Acessa arquivos"
    }

    // Relações entre os elementos de nível superior
    player -> soloHero.gameClient "Joga"
    soloHero.gameClient -> love2d "Utiliza API para gráficos, som e input"
}

// 3. Definição dos diagramas que serão renderizados a partir do modelo.
views {
    // Diagrama C1 - Contexto do Sistema (visão geral)
    view systemContext {
        title "Contexto do Sistema (C1)"
        description "Visão geral do sistema Solo Hero, seus usuários e dependências externas."
        include *
    }

    // Diagrama C2 - Contêineres
    view of soloHero {
        title "Contêineres do Solo Hero (C2)"
        description "Mostra os principais blocos de construção que compõem o sistema Solo Hero."
        include *
    }

    // Diagrama C3 - Componentes do Game Client
    view of soloHero.gameClient {
        title "Arquitetura Geral do Game Client (C3)"
        description "Visão geral das principais camadas e componentes do cliente do jogo."
        include *
    }

    // Diagrama C3.1 - Camada de Serviços
    view of soloHero.gameClient.services {
        title "Camada de Serviços Globais (C3.1)"
        description "Detalha os serviços singleton disponíveis em todo o jogo."
        include *
    }

    // Diagrama C3.2 - Lobby Scene
    view of soloHero.gameClient.lobby {
        title "Arquitetura da Lobby Scene (C3.2)"
        description "Mostra os managers que compõem o hub central do jogo."
        include *
    }

    // Diagrama C3.3 - Data Layer
    view of soloHero.gameClient.dataLayer {
        title "Camada de Dados (C3.3)"
        description "Mostra como os dados são organizados e gerenciados no jogo."
        include *
    }

    // Diagrama C3.4 - Gameplay Scene (placeholder)
    view of soloHero.gameClient.gameplay {
        title "Gameplay Scene (C3.4)"
        description "Cena principal de jogabilidade (detalhes serão adicionados)."
        include *
    }
}